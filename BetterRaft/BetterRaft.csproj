<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>7.3</LangVersion>
		<PlatformTarget>x64</PlatformTarget>

		<AssemblyName>BetterRaft</AssemblyName>
		<RootNamespace>BetterRaft</RootNamespace>

		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>bin\$(Configuration)\</OutputPath>

		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>

		<RaftDir Condition="'$(RaftDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Raft</RaftDir>
		<RmlDir Condition="'$(RmlDir)' == ''">$(APPDATA)\RaftModLoader</RmlDir>
		<RmlBinariesDir>$(RmlDir)\binaries</RmlBinariesDir>
		<RmlPublicizedDir>$(RmlDir)\cache\publicizedAssemblies</RmlPublicizedDir>

		<RaftExePath>$(RaftDir)\Raft.exe</RaftExePath>
		<RaftModsDir>$(RaftDir)\mods</RaftModsDir>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RmlPublicizedDir)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="HMLCoreLibrary">
			<HintPath>$(RmlBinariesDir)\HMLCoreLibrary.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="coremod">
			<HintPath>$(RmlBinariesDir)\coremod.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="0Harmony">
			<HintPath>$(RmlBinariesDir)\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="SemanticVersion">
			<HintPath>$(RmlBinariesDir)\SemanticVersion.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="SharpZipLib">
			<HintPath>$(RmlBinariesDir)\SharpZipLib.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="FMODUnity">
			<HintPath>$(RmlPublicizedDir)\FMODUnity.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine">
			<HintPath>$(RaftDir)\Raft_Data\Managed\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(RaftDir)\Raft_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>$(RaftDir)\Raft_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(RaftDir)\Raft_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.AssetBundleModule">
			<HintPath>$(RaftDir)\Raft_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(RaftDir)\Raft_Data\Managed\UnityEngine.UIModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.UI">
			<HintPath>$(RaftDir)\Raft_Data\Managed\UnityEngine.UI.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(RaftDir)\Raft_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
			<Private>false</Private>
		</Reference>

		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(RaftDir)\Raft_Data\Managed\Unity.TextMeshPro.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<Target Name="ValidateRaftEnvironment" BeforeTargets="ResolveReferences">
		<Error Condition="!Exists('$(RaftExePath)')" Text="Raft.exe не найден: $(RaftExePath)" />

		<Error Condition="!Exists('$(RmlBinariesDir)\HMLCoreLibrary.dll')" Text="HMLCoreLibrary.dll не найден: $(RmlBinariesDir)\HMLCoreLibrary.dll" />

		<Error Condition="!Exists('$(RmlBinariesDir)\coremod.dll')" Text="coremod.dll не найден: $(RmlBinariesDir)\coremod.dll" />

		<Error Condition="!Exists('$(RmlBinariesDir)\0Harmony.dll')" Text="0Harmony.dll не найден: $(RmlBinariesDir)\0Harmony.dll" />

		<Error Condition="!Exists('$(RmlPublicizedDir)\Assembly-CSharp.dll')" Text="Publicized Assembly-CSharp.dll не найден: $(RmlPublicizedDir)\Assembly-CSharp.dll. Запусти Raft через RML хотя бы один раз" />

		<Error Condition="!Exists('$(RmlPublicizedDir)\FMODUnity.dll')" Text="Publicized FMODUnity.dll не найден: $(RmlPublicizedDir)\FMODUnity.dll. Запусти Raft через RML хотя бы один раз" />


		<Error Condition="!Exists('$(RaftDir)\Raft_Data\Managed\UnityEngine.AssetBundleModule.dll')" Text="UnityEngine.AssetBundleModule.dll не найден: $(RaftDir)\Raft_Data\Managed\UnityEngine.AssetBundleModule.dll" />

		<Error Condition="!Exists('$(RaftDir)\Raft_Data\Managed\UnityEngine.UIModule.dll')" Text="UnityEngine.UIModule.dll не найден: $(RaftDir)\Raft_Data\Managed\UnityEngine.UIModule.dll" />

		<Error Condition="!Exists('$(RaftDir)\Raft_Data\Managed\UnityEngine.UI.dll')" Text="UnityEngine.UI.dll не найден: $(RaftDir)\Raft_Data\Managed\UnityEngine.UI.dll" />

		<Error Condition="!Exists('$(RaftDir)\Raft_Data\Managed\Unity.TextMeshPro.dll')" Text="Unity.TextMeshPro.dll не найден: $(RaftDir)\Raft_Data\Managed\Unity.TextMeshPro.dll" />
	</Target>

	<Target Name="BuildRmod" AfterTargets="Build">
		<PropertyGroup>
			<ModName>$([System.Text.RegularExpressions.Regex]::Match('$([System.IO.File]::ReadAllText("$(ProjectDir)modinfo.json"))', '"name"\s*:\s*"([^"]+)"').Groups[1].Value)</ModName>
			<ModVersion>$([System.Text.RegularExpressions.Regex]::Match('$([System.IO.File]::ReadAllText("$(ProjectDir)modinfo.json"))', '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModVersion>

			<RmodTempDir>$(BaseIntermediateOutputPath)rmod\</RmodTempDir>
			<ReleaseDir>$(ProjectDir)..\releases\</ReleaseDir>
			<RmodFile>$(ReleaseDir)$(ModName) v$(ModVersion).rmod</RmodFile>
			<InstalledRmodFile>$(RaftModsDir)\$(ModName) v$(ModVersion).rmod</InstalledRmodFile>
			<LegacyDevRmodFile>$(RaftModsDir)\BetterRaft.dev.rmod</LegacyDevRmodFile>
		</PropertyGroup>

		<Error Condition="!Exists('$(ProjectDir)modinfo.json')" Text="modinfo.json не найден в корне проекта" />

		<RemoveDir Directories="$(RmodTempDir)" Condition="Exists('$(RmodTempDir)')" />

		<MakeDir Directories="$(RmodTempDir)" />
		<MakeDir Directories="$(ReleaseDir)" />
		<MakeDir Directories="$(RaftModsDir)" Condition="!Exists('$(RaftModsDir)')" />

		<ItemGroup>
			<RmodFiles Include="$(ProjectDir)**\*" Exclude="$(ProjectDir)bin\**;$(ProjectDir)obj\**" />
		</ItemGroup>

		<Copy SourceFiles="@(RmodFiles)" DestinationFiles="@(RmodFiles->'$(RmodTempDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />

		<Delete Files="$(RmodFile)" Condition="Exists('$(RmodFile)')" />

		<ZipDirectory SourceDirectory="$(RmodTempDir)" DestinationFile="$(RmodFile)" Overwrite="true" />

		<RemoveDir Directories="$(RmodTempDir)" />

		<Delete Files="$(InstalledRmodFile)" Condition="Exists('$(InstalledRmodFile)')" />

		<Delete Files="$(LegacyDevRmodFile)" Condition="Exists('$(LegacyDevRmodFile)')" />

		<Copy SourceFiles="$(RmodFile)" DestinationFiles="$(InstalledRmodFile)" />

		<Message Importance="high" Text="Release RMod создан: $(RmodFile)" />

		<Message Importance="high" Text="Release RMod установлен: $(InstalledRmodFile)" />
	</Target>

	<Target Name="LaunchRaftDev" AfterTargets="BuildRmod">
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$p = Get-Process -Name Raft -ErrorAction SilentlyContinue; if ($null -ne $p) { Write-Warning 'Raft уже запущен - закрой игру и запусти сборку ещё раз'; exit 0 }; $steam = (Get-ItemProperty -Path 'HKCU:\Software\Valve\Steam' -ErrorAction SilentlyContinue).SteamExe; if ([string]::IsNullOrWhiteSpace($steam)) { $steam = Join-Path ${env:ProgramFiles(x86)} 'Steam\steam.exe' }; if (!(Test-Path $steam)) { throw 'Steam.exe не найден' }; Start-Process -FilePath $steam -ArgumentList '-applaunch 648800 -rml -BetterRaft-dev'; Write-Host 'Raft запущен через Steam с RML'&quot;" />
	</Target>

</Project>
